; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PULSO"
config/description="Puzzle-plataformas de trazo unico"
run/main_scene="res://escenas/MenuPrincipal.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://arte/icono/icono_192.png"

[autoload]

Efectos="*res://scripts/efectos.gd"
Guardado="*res://scripts/guardado.gd"
Audio="*res://scripts/audio.gd"
Teclas="*res://scripts/teclas.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

